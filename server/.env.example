# Server
PORT=3000
# Comma-separated list of allowed origins for CORS, or * for any (dev only)
CORS_ORIGIN=*

# SMTP (Gmail, SendGrid SMTP, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# From address (must be allowed by your SMTP provider)
MAIL_FROM=noreply@example.com

# Optional: your inbox — receive a copy of each new booking
MAIL_TO=
